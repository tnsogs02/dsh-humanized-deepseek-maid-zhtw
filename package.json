{
  "name": "dsh-humanized-deepseek-maid",
  "version": "0.6.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tnsogs02/dsh-humanized-deepseek-maid-zhtw.git"
  },
  "description": "Optimized fork: DeepSeek Harness whale-girl maid persona with native Traditional Chinese (zh-TW, with zh-CN option), no built-in memory (use the recommended dsh-meow-memory instead), and cloud-safety-filter-friendly persona tags.",
  "main": "lib/index.mjs",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-TW.md",
    "README.zh-CN.md"
  ],
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "persona",
    "roleplay",
    "maid",
    "whale-girl",
    "zh-TW"
  ],
  "license": "MIT"
}
